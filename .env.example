# Public URL of the Supabase project (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://ssxygllbnkjoklfhdfkb.supabase.co

# Anonymous (public) API key. Safe to expose; subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only key that BYPASSES Row Level Security.
# Never expose to the browser. Used by lib/supabase/admin.ts for the admin area.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
